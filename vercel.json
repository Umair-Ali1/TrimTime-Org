{
  "version": 2,
  "name": "trimtime",
  "builds": [
    { "src": "api/ai.js", "use": "@vercel/node" },
    { "src": "**/*.html", "use": "@vercel/static" },
    { "src": "**/*.css", "use": "@vercel/static" },
    { "src": "app_state.js", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/ai", "dest": "/api/ai.js" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
